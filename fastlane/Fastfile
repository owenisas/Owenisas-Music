default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight. This build INCLUDES the YouTube downloader (TestFlight only)."
  lane :beta do
    # Increment build number (uses the current timestamp for uniqueness)
    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "Owenisas Music.xcodeproj"
    )

    # Build with no APP_STORE flag -> YouTube code compiles in.
    build_app(
      scheme: "Owenisas Music",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "OwenisasMusic.ipa",
      export_options: {
        signingStyle: "automatic",
        teamID: "3LHSL95J9H"
      },
      xcargs: "-allowProvisioningUpdates"
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Build the App Store submission. Ships import-only (no YouTube code)."
  lane :release do
    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "Owenisas Music.xcodeproj"
    )

    # Set APP_STORE so YouTube code is compiled out of the App Store binary.
    build_app(
      scheme: "Owenisas Music",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "OwenisasMusic.ipa",
      export_options: {
        signingStyle: "automatic",
        teamID: "3LHSL95J9H"
      },
      xcargs: "-allowProvisioningUpdates OWENISAS_DISTRIBUTION=appstore SWIFT_ACTIVE_COMPILATION_CONDITIONS='APP_STORE $(inherited)'"
    )
  end

  desc "Just build TestFlight IPA (no upload)"
  lane :build_only do
    build_app(
      scheme: "Owenisas Music",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "OwenisasMusic.ipa",
      export_options: {
        signingStyle: "automatic",
        teamID: "3LHSL95J9H"
      },
      xcargs: "-allowProvisioningUpdates"
    )
  end
end
